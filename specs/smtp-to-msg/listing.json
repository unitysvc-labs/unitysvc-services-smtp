{
  "currency": "USD",
  "display_name": "SMTP-to-Message Bridge (Apprise envelope)",
  "documents": {
    "Connectivity test": {
      "$doc_preset": "smtp_connectivity_v2"
    },
    "How to use this service": {
      "category": "getting_started",
      "description": "How the SMTP-to-Message bridge works and the two ways to use it \u2014 a stored receiver (free) or per-enrollment receivers (metered)",
      "file_path": "description.md",
      "is_active": true,
      "is_public": true,
      "mime_type": "markdown"
    }
  },
  "list_price": {
    "channels": {
      "byok": {
        "description": "Free \u2014 customer provides own HTTP receiver",
        "price": "0",
        "type": "constant"
      },
      "plus": {
        "description": "$1 per 1,000 emails (1,000 emails per dollar)",
        "price": "0.001",
        "type": "constant"
      }
    },
    "default": "byok",
    "type": "channel"
  },
  "name": "smtp-to-msg",
  "service_options": {
    "ops_testing_parameters": {
      "api_key_secret": "HTTP_RELAY_API_KEY",
      "base_url": "https://echo.unitysvc.dev"
    }
  },
  "status": "ready",
  "time_created": "2026-06-04T00:00:00Z",
  "user_access_interfaces": {
    "enrollment": {
      "access_method": "smtp",
      "base_url": "${SMTP_GATEWAY_BASE_URL}",
      "routing_key": {
        "username": "{{ enrollment.code }}"
      }
    },
    "smtp_gateway": {
      "access_method": "smtp",
      "base_url": "${SMTP_GATEWAY_BASE_URL}",
      "routing_key": {
        "username": "smtp-to-msg"
      }
    }
  },
  "user_parameters_schema": {
    "properties": {
      "api_key_secret": {
        "default": "",
        "description": "Name of the customer secret holding the receiver's bearer token. Leave empty if the receiver doesn't need auth.",
        "type": "string"
      },
      "base_url": {
        "description": "Customer's Apprise-compatible HTTP receiver URL (e.g. https://apprise.unitysvc.dev/notify/<key>)",
        "format": "uri",
        "type": "string"
      }
    },
    "required": [
      "base_url"
    ],
    "type": "object"
  }
}
