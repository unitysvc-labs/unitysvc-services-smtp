#!/bin/bash
# smtp-to-api-gateway forwards an inbound email into a route on the UnitySVC
# API Gateway, authenticated as you (your svcpass is replayed as the bearer
# token). Which route, and in which payload format, is configuration:
#   default channel : SMTP_TO_API_GATEWAY_TARGET / SMTP_TO_API_GATEWAY_FORMAT secrets
#   plus channel    : the enrollment's `target` / `payload_format` parameters
#
# Here the target route is http-to-sink, which forwards to the platform sink
# (sink.unitysvc.dev). The sink records each request, so we can CONFIRM delivery
# end to end: send with a unique marker, then long-poll the sink for it.
set -euo pipefail

SINK="https://sink.unitysvc.dev"
MARKER="smtp2api-$(date +%s)-${RANDOM}"
SUBJECT="smtp-to-api-gateway example ${MARKER}"

{% if local_testing %}
# Upstream mode: probe the target route on the API gateway — the hop the SMTP
# gateway performs on your behalf. No customer credential is available here
# (this service's upstream carries none; auth_mode: forward replays the
# caller's own), and SERVICE_BASE_URL still holds the literal
# ${API_GATEWAY_BASE_URL} macro, which only the gateway expands — so default
# the host and accept any non-5xx: 401 is the expected unauthenticated answer.
: "${API_GATEWAY_BASE_URL:=https://api.svcpass.com}"
URL="{{ service_base_url }}"
status=$(curl -sS -o /dev/null -w '%{http_code}' -X POST "$URL" \
  -H 'Content-Type: application/json' \
  --data "{\"title\":\"${SUBJECT}\",\"body\":\"hello from smtp-to-api-gateway\",\"type\":\"info\",\"format\":\"text\"}" 2>/dev/null || echo 000)
case "$status" in
  5??|000|"") echo "route ${URL} unreachable (HTTP ${status:-000})" >&2; exit 1 ;;
esac
echo "route ${URL} reachable (HTTP ${status}) — send end to end with the gateway example below"
exit 0
{% else %}
# Gateway send: submit the email over SMTP. Username selects the bridge (the
# service name, or an enrollment code on the plus channel); password is your
# svcpass. Any To: address works — routing is by SMTP username, not recipient.
# Lines must be CRLF-terminated (Haraka rejects bare LF), hence printf.
printf 'From: test@example.com\r\nTo: recipient@example.com\r\nSubject: %s\r\n\r\nhello from smtp-to-api-gateway\r\n' "${SUBJECT}" \
  | curl --silent --show-error --ssl --url "{{ service_base_url }}" \
    --user "{{ routing_key.username }}:${UNITYSVC_API_KEY:?set UNITYSVC_API_KEY to your svcpass}" \
    --mail-from "test@example.com" --mail-rcpt "recipient@example.com" \
    --upload-file -
{% endif %}

# Confirm delivery by querying the receiver behind the route: the sink
# long-polls up to 30s for a recorded request carrying our marker.
if curl -sS "${SINK}/retrieve?search=${MARKER}&wait=30" | grep -q "${MARKER}"; then
  echo "delivered — sink recorded the forwarded request (${MARKER})"
else
  echo "NOT delivered — no request carrying ${MARKER} reached ${SINK}" >&2
  exit 1
fi
