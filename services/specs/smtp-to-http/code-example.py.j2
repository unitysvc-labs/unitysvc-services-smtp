#!/usr/bin/env python3
"""smtp-to-http forwards an inbound email to your HTTP receiver as the full
email envelope (from, to, subject, text_body, html_body, headers, attachments,
spf/dkim).

Here the receiver is the platform sink (sink.unitysvc.dev), which records each
request, so we CONFIRM delivery end to end: send with a unique marker in the
subject, then long-poll the sink for a recorded request carrying it."""
import json
import os
import time
import urllib.request

{% if local_testing %}
{% else %}
import smtplib
from email.message import EmailMessage
from urllib.parse import urlparse
{% endif %}

SINK = "https://sink.unitysvc.dev"  # = SMTP_HTTP_RELAY_BASE_URL receiver
marker = f"smtp2http-{int(time.time())}-{os.getpid()}"  # unique per run
subject = f"smtp-to-http e2e {marker}"

{% if local_testing %}
# Upstream test: POST the email envelope straight to the receiver (the sink).
payload = {
    "from": "test@example.com",
    "to": "recipient@example.com",
    "subject": subject,
    "text_body": "hello",
}
req = urllib.request.Request(
    SINK,
    data=json.dumps(payload).encode(),
    method="POST",
    headers={"Content-Type": "application/json"},
)
with urllib.request.urlopen(req, timeout=10) as resp:
    assert 200 <= resp.status < 300, f"receiver returned HTTP {resp.status}"
{% else %}
# Gateway send: submit the email over SMTP; the gateway forwards the full
# envelope (subject -> subject, body -> text_body, headers, ...) as JSON.
parsed = urlparse("{{ service_base_url }}")
msg = EmailMessage()
msg["From"] = "test@example.com"
msg["To"] = "recipient@example.com"
msg["Subject"] = subject
msg.set_content("hello from smtp-to-http")
cls = smtplib.SMTP_SSL if parsed.scheme == "smtps" else smtplib.SMTP
with cls(parsed.hostname, parsed.port or 587, timeout=10) as server:
    if parsed.scheme != "smtps":
        server.ehlo()
        if server.has_extn("STARTTLS"):
            server.starttls()
            server.ehlo()
    server.login("{{ routing_key.username }}", os.environ["UNITYSVC_API_KEY"])
    server.send_message(msg)
{% endif %}

# Confirm delivery by querying the receiver: the sink long-polls up to 30s for a
# recorded request whose body carries our marker (the forwarded Subject).
with urllib.request.urlopen(f"{SINK}/retrieve?search={marker}&wait=30", timeout=35) as resp:
    hits = json.loads(resp.read())
assert hits, f"NOT delivered — no request carrying {marker} reached {SINK}"
print(f"delivered — sink recorded the forwarded email envelope ({marker})")
